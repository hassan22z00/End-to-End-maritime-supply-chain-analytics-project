Data Quality & Testing Schema: models/marts/marts.yml

version: 2

models:
  - name: dim_ports
    description: "Standardized dimensional registry of global seaports containing geolocation metrics."
    columns:
      - name: un_locode
        description: "Primary key for port identification (UN/LOCODE format)."
        tests:
          - unique
          - not_null

  - name: fct_port_congestion
    description: "Daily fact table evaluating vessel traffic, terminal throughput, and financial delay penalties."
    columns:
      - name: congestion_key
        description: "Surrogate primary key generated via MD5 hash."
        tests:
          - unique
          - not_null
